# ==============================================================================
# CONEXIONES ETERNAS • ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. OpenRouter API Key for Gemini Models (Required for AI Scholar & Daily Meditation Cron)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# 2. Vercel Cron Secret (Secures /api/cron/generate-daily-meditation endpoint)
# Generate a secure random token (e.g., openssl rand -hex 32)
# In Vercel Project Settings > Environment Variables, set CRON_SECRET with this value.
# Vercel automatically sends this as 'Authorization: Bearer <CRON_SECRET>' on cron runs.
CRON_SECRET=your-random-cron-secret-token

# 3. Persistent Storage (Vercel KV or Upstash Redis REST API)
# Automatically populated when you connect a Vercel KV database to your project in the Vercel dashboard:
# Storage -> Create Database -> KV -> Connect to Project.
KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# Optional Upstash Redis direct aliases (supported interchangeably with KV_REST_API_*)
UPSTASH_REDIS_REST_URL=https://your-kv-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_kv_rest_api_token_here
